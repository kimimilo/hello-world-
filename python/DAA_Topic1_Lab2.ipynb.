        "def addition(num1, num2):                             # things inside () are called parameters\n",
        "    total = num1 + num2\n",
        "    return total\n",
        "\n",
        "def circle_properties(radius):\n",
        "    \"\"\"return the area & circumference of a circle\"\"\" # spans new lines naturally & preserves formatting\n",
        "    area = math.pi * radius ** 2                      # ** means to power/square smth\n",
        "    circumference = 2 *math.pi * radius\n",
        "    return area, circumference\n",
        "\n",
        "def is_palindrome(word):\n",
        "    word = word.lower().replace(\" \",\"\")\n",
        "    return word == word[::-1]                         # [:: -1 reverses a string to set up palindrome to check if it is]\n",
        "\n",
        "print(addition(5,7))\n",
        "area, circumference = circle_properties (5)\n",
        "print(f\"area: {area:.2f}, circumference: {circumference:.2f}\")\n",
        "print(is_palindrome(\"taco cat\"),                      # chekcking if when read backwords = the same as when reading normally\n",
