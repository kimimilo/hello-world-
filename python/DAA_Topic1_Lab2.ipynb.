        "    \"S01\": {\"name\": \"Xaylin\", \"scores\": {\"math\": 88, \"english\": 48, \"science\": 43}},\n",
        "    \"S02\": {\"name\": \"Heidi\", \"scores\": {\"math\": 45, \"english\": 40, \"science\": 51}},\n",
        "    \"S03\": {\"name\": \"Kimi\", \"scores\": {\"math\": 59, \"english\": 77, \"science\": 62}},\n",
        "    \"S04\": {\"name\": \"Wenxuan\", \"scores\": {\"math\": 80, \"english\": 70, \"science\": 90}},\n",
        "    }\n",
        "\n",
        "def average(scores):\n",
        "    return sum(scores.values())/len(scores)\n",
        "\n",
        "def letter_grade(avg):\n",
        "    if avg >= 70:\n",
        "        return \"A\"\n",
        "    elif avg >= 60:\n",
        "        return \"B\"\n",
        "    elif avg >= 50:\n",
        "        return \"c\"\n",
        "    else:\n",
        "        return \"F\"\n",
        "\n",
        "class_average = {}\n",
        "print(f\"{'iD':<4} {'name':<6} {'avg':>6} grade\")\n",
        "for student_id, info in school_records.items():\n",
        "  avg = average(info[\"scores\"])\n",
        "  class_average[info[\"name\"]] = avg             # the dictionary where uw to save e averages\n",
        "                                                # info[name] gets the students name from the dictionary\n",
        "                                                # avg gets the average calculated from the prev line\n",
        "  print(f\"{student_id:<4} {info['name']:<6} {avg:>6.1f} {letter_grade(avg)}\")\n",
        "\n",
        "best = max(class_average, key=class_average.get)\n",
        "print(f\"\\nClass average: {sum(class_average.values()) / len(class_average):.1f}\")\n",
